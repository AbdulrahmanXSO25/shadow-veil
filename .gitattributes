# Normalize text files to LF in the repository.
* text=auto eol=lf

*.sh    text eol=lf
*.bat   text eol=crlf

# Binary assets
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.wav   binary
*.ogg   binary

# Keep these diffs readable
*.lvl   text
*.cut   text
