# Matches the style already used in src/: four spaces, attached braces, left-aligned pointers.
# Formatting is guidance, not CI-enforced, so existing files are not churned.
BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
AccessModifierOffset: -4
BreakBeforeBraces: Attach
PointerAlignment: Left
ReferenceAlignment: Left
NamespaceIndentation: None
SortIncludes: Never
IncludeBlocks: Preserve
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
SpaceAfterCStyleCast: true
